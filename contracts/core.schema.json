      "$ref": "urn:safehandoff:core-contracts:shared:v1#/$defs/scope"
    },
    "representation": {
      "$ref": "urn:safehandoff:core-contracts:shared:v1#/$defs/representation"
    },
    "create_task": {
      "$ref": "urn:safehandoff:core-contracts:requests:v1#/$defs/create_task"
    },
    "create_preview": {
      "$ref": "urn:safehandoff:core-contracts:requests:v1#/$defs/create_preview"
    },
    "decision_item": {
      "$ref": "urn:safehandoff:core-contracts:requests:v1#/$defs/decision_item"
    },
    "decision_batch": {
      "$ref": "urn:safehandoff:core-contracts:requests:v1#/$defs/decision_batch"
    },
    "finalize": {
      "$ref": "urn:safehandoff:core-contracts:requests:v1#/$defs/finalize"
    },
    "delete_task": {
      "$ref": "urn:safehandoff:core-contracts:requests:v1#/$defs/delete_task"
    },
    "fact": {
      "$ref": "urn:safehandoff:core-contracts:models:v1#/$defs/fact"
    },
    "draft_block": {
      "$ref": "urn:safehandoff:core-contracts:models:v1#/$defs/draft_block"
    },
    "draft": {
      "$ref": "urn:safehandoff:core-contracts:models:v1#/$defs/draft"
    },
    "candidate_proposal": {
      "$ref": "urn:safehandoff:core-contracts:models:v1#/$defs/candidate_proposal"
    },
    "candidate_proposals": {
      "$ref": "urn:safehandoff:core-contracts:models:v1#/$defs/candidate_proposals"
    }
  }
}
