{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safehandoff:core-contracts:v1",
  "title": "SafeHandoff P0 core request/model contracts",
  "description": "Reusable definitions. Validate a named $defs entry; additional domain checks in docs/api.md are mandatory. Extension tool schemas are registered separately.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "purpose_id": {
          "type": "string",
          "enum": [
            "oss_issue",
            "vendor_support",
            "operations_advice"
          ]
        },
        "goal_variant": {
          "type": "string",
          "enum": [
            "default",
            "observations_only",
            "ask_for_diagnostics",
            "reproduction_evidence"
          ]
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "audience": {
          "type": "string",
          "enum": [
            "public",
            "named_external"
          ]
        },
        "skill_set_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "project_id",
        "purpose_id",
        "goal_variant",
        "recipient_id",
        "audience",
        "skill_set_hash"
      ]
    },
    "representation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fact_summary"
            },
            "transform_id": {
              "const": "series_fact_summary.v1"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          },
          "required": [
            "kind",
            "transform_id",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fact_summary"
            },
            "transform_id": {
              "type": "null"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "required": [
                "statement"
              ]
            }
          },
          "required": [
            "kind",
            "transform_id",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "derived_table"
            },
            "transform_id": {
              "const": "series_direction_only.v1"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          },
          "required": [
            "kind",
            "transform_id",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "derived_table"
            },
            "transform_id": {
              "const": "series_index_base100.v1"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "decimal_places": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": [
                "decimal_places"
              ]
            }
          },
          "required": [
            "kind",
            "transform_id",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "selected_fields"
            },
            "transform_id": {
              "const": "select_fields.v1"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "maxItems": 30
                }
              },
              "required": [
                "fields"
              ]
            }
          },
          "required": [
            "kind",
            "transform_id",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "exact_value"
            },
            "transform_id": {
              "type": "null"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "minItems": 1,
                  "maxItems": 30
                }
              },
              "required": [
                "evidence_ids"
              ]
            }
          },
          "required": [
            "kind",
            "transform_id",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "approved_excerpt"
            },
            "transform_id": {
              "type": "null"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_version_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "hidden_ranges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ]
                  },
                  "minItems": 0
                }
              },
              "required": [
                "source_version_id",
                "start",
                "end",
                "hidden_ranges"
              ]
            }
          },
          "required": [
            "kind",
            "transform_id",
            "parameters"
          ]
        }
      ]
    },
    "create_task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "internal_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "purpose_id": {
          "type": "string",
          "enum": [
            "oss_issue",
            "vendor_support",
            "operations_advice"
          ]
        },
        "goal_variant": {
          "type": "string",
          "enum": [
            "default",
            "observations_only",
            "ask_for_diagnostics",
            "reproduction_evidence"
          ]
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "audience": {
          "type": "string",
          "enum": [
            "public",
            "named_external"
          ]
        },
        "output_language": {
          "type": "string",
          "enum": [
            "ko",
            "en"
          ]
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "required": [
        "internal_title",
        "project_id",
        "purpose_id",
        "goal_variant",
        "recipient_id",
        "audience",
        "output_language",
        "skill_ids"
      ]
    },
    "create_preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "representation": {
          "$ref": "#/$defs/representation"
        },
        "extension_option_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "expected_revision",
        "candidate_id",
        "representation"
      ]
    },
    "decision_item": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "candidate_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "disposition": {
              "const": "allow"
            },
            "preview_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "approved_projection_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "save_rule": {
              "type": "boolean"
            }
          },
          "required": [
            "candidate_id",
            "disposition",
            "preview_id",
            "approved_projection_sha256",
            "expires_at",
            "save_rule"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "candidate_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "disposition": {
              "enum": [
                "exclude",
                "defer"
              ]
            }
          },
          "required": [
            "candidate_id",
            "disposition"
          ]
        }
      ]
    },
    "decision_batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_item"
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "expected_revision",
        "items"
      ]
    },
    "finalize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expected_artifact_set_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "expected_revision",
        "expected_artifact_set_hash",
        "confirm"
      ]
    },
    "delete_task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "confirmation": {
          "const": "DELETE"
        },
        "acknowledge_saved_rules_retained": {
          "const": true
        }
      },
      "required": [
        "expected_revision",
        "confirmation",
        "acknowledge_saved_rules_retained"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "observation",
            "constraint",
            "hypothesis",
            "unknown"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "id",
        "kind",
        "statement"
      ]
    },
    "draft_block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "heading"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "text": {
              "type": "string"
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "minItems": 0
            }
          },
          "required": [
            "type",
            "level",
            "text",
            "fact_ids"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "text": {
              "type": "string"
            },
            "fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "minItems": 0
            }
          },
          "required": [
            "type",
            "text",
            "fact_ids"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "fact_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "text",
                  "fact_ids"
                ]
              },
              "minItems": 1,
              "maxItems": 60
            }
          },
          "required": [
            "type",
            "items"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "table_ref"
            },
            "table_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "type",
            "table_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "excerpt_ref"
            },
            "excerpt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "type",
            "excerpt_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "asset_ref"
            },
            "asset_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "type",
            "asset_id"
          ]
        }
      ]
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "draft.v1"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/draft_block"
          },
          "minItems": 1,
          "maxItems": 60
        }
      },
      "required": [
        "schema_version",
        "blocks"
      ]
    },
    "candidate_proposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "observation",
            "constraint",
            "hypothesis",
            "unknown"
          ]
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "observed",
            "reported",
            "inferred",
            "unknown"
          ]
        },
        "statement": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "minItems": 1,
          "maxItems": 50
        },
        "relevance": {
          "type": "string",
          "enum": [
            "required",
            "optional"
          ]
        },
        "purpose_relevance": {
          "type": "string"
        },
        "need_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "constraints",
              "diagnostic_question",
              "environment",
              "expectation",
              "observation",
              "observed_sequence",
              "process",
              "question",
              "reproduction_result",
              "uncertainty"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "local_key",
        "kind",
        "uncertainty",
        "statement",
        "evidence_ids",
        "relevance",
        "purpose_relevance",
        "need_keys"
      ]
    },
    "candidate_proposals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "candidate_proposals.v1"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_proposal"
          },
          "minItems": 0,
          "maxItems": 30
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "local_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "minItems": 2,
                "maxItems": 30
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "local_keys",
              "reason"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "candidates",
        "conflicts"
      ]
    }
  }
}
