{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 8192,
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "maxLength": 8192,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "error_code": {
      "maxLength": 8192,
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "maxLength": 8192,
      "type": "string"
    },
    "input_revision": {
      "type": "integer"
    },
    "kind": {
      "maxLength": 8192,
      "type": "string"
    },
    "previous_phase": {
      "maxLength": 8192,
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "candidate_id": {
              "maxLength": 8192,
              "type": "string"
            },
            "representation": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "fact_summary",
                        "derived_table",
                        "selected_fields",
                        "exact_value",
                        "approved_excerpt"
                      ],
                      "maxLength": 8192,
                      "type": "string"
                    },
                    "parameters": {
                      "additionalProperties": false,
                      "maxProperties": 5,
                      "properties": {
                        "base_epoch_seconds": {
                          "type": "integer"
                        },
                        "decimal_places": {
                          "maximum": 4,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "end_row": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "include_count": {
                          "maximum": 1,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "include_observation": {
                          "maximum": 1,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "include_unit": {
                          "maximum": 1,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "start_row": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "transform_id": {
                      "enum": [
                        "",
                        "series_direction_only.v1",
                        "series_index_base100.v1",
                        "timeline_sequence_only.v1",
                        "timeline_relative_intervals.v1",
                        "timeline_shifted_absolute.v1",
                        "timeline_synthetic_schedule.v1"
                      ],
                      "maxLength": 8192,
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "transform_id",
                    "parameters"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requires_clarification": {
              "type": "boolean"
            },
            "schema_version": {
              "maxLength": 8192,
              "type": "string"
            },
            "status": {
              "enum": [
                "supported",
                "ambiguous",
                "unsupported"
              ],
              "maxLength": 8192,
              "type": "string"
            }
          },
          "required": [
            "schema_version",
            "status",
            "candidate_id",
            "representation",
            "requires_clarification"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "maxLength": 8192,
      "type": "string"
    },
    "task_id": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "arguments",
    "result",
    "previous_phase",
    "id",
    "task_id",
    "input_revision",
    "kind",
    "status",
    "cancel_requested",
    "error_code",
    "started_at",
    "finished_at"
  ],
  "title": "job.v1",
  "type": "object"
}
