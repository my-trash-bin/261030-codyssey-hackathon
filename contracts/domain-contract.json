      "oss_issue",
      "vendor_support",
      "operations_advice"
    ],
    "goal_variant": [
      "default",
      "observations_only",
      "ask_for_diagnostics",
      "reproduction_evidence"
    ],
    "audience": [
      "public",
      "named_external"
    ],
    "output_language": [
      "ko",
      "en"
    ],
    "task_phase": [
      "needs_analysis",
      "needs_decisions",
      "ready_to_generate",
      "processing",
      "needs_attention",
      "ready_to_finalize",
      "finalized"
    ],
    "artifact_status": [
      "draft",
      "checking",
      "blocked",
      "ready",
      "finalized",
      "stale"
    ],
    "job_kind": [
      "analyze",
      "interpret_condition",
      "compose",
      "review",
      "reproduce",
      "provider_check"
    ],
    "job_status": [
      "queued",
      "running",
