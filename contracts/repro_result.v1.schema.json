{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "input_set_sha256": {
      "maxLength": 8192,
      "type": "string"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "ascii": {
          "additionalProperties": false,
          "properties": {
            "codepoints": {
              "type": "integer"
            },
            "sha256": {
              "maxLength": 8192,
              "type": "string"
            },
            "utf8_bytes": {
              "type": "integer"
            }
          },
          "required": [
            "codepoints",
            "utf8_bytes",
            "sha256"
          ],
          "type": "object"
        },
        "multibyte": {
          "additionalProperties": false,
          "properties": {
            "codepoints": {
              "type": "integer"
            },
            "sha256": {
              "maxLength": 8192,
              "type": "string"
            },
            "utf8_bytes": {
              "type": "integer"
            }
          },
          "required": [
            "codepoints",
            "utf8_bytes",
            "sha256"
          ],
          "type": "object"
        }
      },
      "required": [
        "ascii",
        "multibyte"
      ],
      "type": "object"
    },
    "reason_code": {
      "maxLength": 8192,
      "type": "string"
    },
    "runs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "exit_code": {
            "type": "integer"
          },
          "input": {
            "maxLength": 8192,
            "type": "string"
          },
          "output_exists": {
            "type": "boolean"
          },
          "output_matches": {
            "type": "boolean"
          },
          "result": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "anyOf": [
                  {
                    "maxLength": 8192,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "schema_version": {
                "maxLength": 8192,
                "type": "string"
              },
              "stage": {
                "enum": [
                  "parse",
                  "validate",
                  "encode",
                  "persist"
                ],
                "maxLength": 8192,
                "type": "string"
              },
              "status": {
                "enum": [
                  "ok",
                  "domain_error",
                  "execution_error"
                ],
                "maxLength": 8192,
                "type": "string"
              }
            },
            "required": [
              "schema_version",
              "status",
              "stage",
              "code"
            ],
            "type": "object"
          },
          "target": {
            "maxLength": 8192,
            "type": "string"
          }
        },
        "required": [
          "target",
          "input",
          "result",
          "exit_code",
          "output_exists",
          "output_matches"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": [
        "array",
        "null"
      ]
    },
    "schema_version": {
      "const": "repro_result.v1"
    },
    "seed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "not_requested",
        "not_run",
        "running",
        "reproduced",
        "not_reproduced",
        "inconclusive",
        "error"
      ],
      "maxLength": 8192,
      "type": "string"
    },
    "target_pair_digest": {
      "maxLength": 8192,
      "type": "string"
    }
  },
  "required": [
    "seed",
    "target_pair_digest",
    "input_set_sha256",
    "inputs",
    "schema_version",
    "status",
    "reason_code",
    "runs"
  ],
  "title": "repro_result.v1",
  "type": "object"
}
