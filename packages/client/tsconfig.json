{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": [
      "ES2023",
      "ES2024.Promise",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
