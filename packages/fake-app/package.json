{
  "name": "@safehandoff/fake-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=development --test src/*.test.ts",
    "dev": "node --conditions=development --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@safehandoff/core-interface": "workspace:*",
    "@safehandoff/server": "workspace:*",
    "@safehandoff/fake-core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "7.3.7"
  }
}
