import { readFile, writeFile } from 'node:fs/promises';
import { fileURLToPath, pathToFileURL } from 'node:url';

export interface Slide {
  id: string;
  label: string;
  fileName: string;
}

export const SLIDES: readonly Slide[] = [
  { id: 'slide-cover', label: '표지', fileName: 'SafeHandoff_표지.html' },
  { id: 'slide-problem', label: '1. 프로젝트 배경', fileName: 'SafeHandoff_문제_사용자.html' },
  { id: 'slide-dilemma', label: '2. 페르소나·문제 정의', fileName: 'SafeHandoff_문제_딜레마.html' },
  { id: 'slide-after', label: '3. 솔루션 및 유저플로우', fileName: 'SafeHandoff_전후_비교.html' },
  { id: 'slide-diff', label: '4. 서비스 차별점', fileName: 'SafeHandoff_서비스_차별점.html' },
  { id: 'slide-dev-scope', label: '5. AI 기술·직접 개발 범위', fileName: 'SafeHandoff_직접_개발_범위.html' },
  { id: 'slide-tech', label: '6. 기술 스택', fileName: 'SafeHandoff_기술_스택.html' },
  { id: 'slide-team', label: '7. 팀원 역할', fileName: 'SafeHandoff_팀원_소개.html' },
  { id: 'slide-resources', label: '8. 외부 자원', fileName: 'SafeHandoff_외부_자원.html' },
  { id: 'slide-effect', label: '9. 기대효과', fileName: 'SafeHandoff_기대효과.html' },
  { id: 'slide-expansion', label: '10. 확장 가능성', fileName: 'SafeHandoff_확장_가능성.html' },
];

export interface ExtractedSlide {
  scopedCss: string;
  pageHtml: string;
}

export function extractStyleAndPage(html: string, slide: Slide): ExtractedSlide {
  const style = html.match(/<style>([\s\S]*?)<\/style>/);
  if (!style?.[1]) throw new Error(`PRESENTATION_STYLE_MISSING: ${slide.fileName}`);

  const main = html.match(/<main[^>]*>([\s\S]*?)<\/main>/);
  if (!main?.[1]) throw new Error(`PRESENTATION_MAIN_MISSING: ${slide.fileName}`);

  const css = style[1]
    .replace(/@media\s*\(\s*max-width\s*:\s*7\d0px\s*\)\s*\{.*?\n\}/gs, '')
    .replace(/@media\s+print\s*\{.*?\n\}/gs, '')
    .replaceAll(':root', '&');
  let pageHtml = main[1].trim();
  for (const target of SLIDES) {
    pageHtml = pageHtml.replaceAll(`href="${target.fileName}"`, `href="#${target.id}"`);
  }
  return { scopedCss: `#${slide.id} {\n${css}\n}\n`, pageHtml };
}

export function renderCombinedDeck(extracted: readonly (Slide & ExtractedSlide)[]): string {
  if (extracted.length !== SLIDES.length) {
    throw new Error(`PRESENTATION_SLIDE_COUNT_INVALID: ${extracted.length}`);
  }
  const styles = extracted.map(slide => `/* === ${slide.fileName} === */\n${slide.scopedCss}`).join('');
  const sections = extracted
    .map(slide => `  <div class="slide-scope" id="${slide.id}">\n    ${slide.pageHtml}\n  </div>`)
    .join('\n');
  const navigation = extracted
    .map(slide => `      <a class="tool-button" href="#${slide.id}">${slide.label}</a>`)
    .join('\n');

  return `<!doctype html>
<!-- Generated by tools/build-presentation-html.mts from individual slides. Product sources: ../../intent.md, ../spec.md, ../architecture.md, ../api.md and ../../README.md. Presentation notes: README.md and ISSUES.md. Do not edit this generated file directly. -->
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#163172">
<meta name="description" content="SafeHandoff 코디세이 해커톤 발표자료 통합본">
<title>SafeHandoff · 발표자료 통합본</title>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#163172;
  --blue:#1e5eff;
  --ink:#111827;
