import assert from 'node:assert/strict';
import { test } from 'node:test';
import {
  extractStyleAndPage,
  renderCombinedDeck,
  SLIDES,
} from './build-presentation-html.mts';

test('presentation extraction scopes CSS and rewrites slide links', () => {
  const slide = SLIDES[0];
  assert(slide);
  const html = `<style>:root { color: red; }
@media print {
  .page { color: black; }
}
</style><main><a href="${SLIDES[1]?.fileName}">next</a></main>`;
  const result = extractStyleAndPage(html, slide);
  assert.match(result.scopedCss, /^#slide-cover \{/);
  assert.match(result.scopedCss, /& \{ color: red; \}/);
  assert.doesNotMatch(result.scopedCss, /@media print/);
  assert.match(result.pageHtml, /href="#slide-problem"/);
});

test('presentation extraction rejects malformed slide sources', () => {
  const slide = SLIDES[0];
  assert(slide);
  assert.throws(() => extractStyleAndPage('<main>page</main>', slide), /PRESENTATION_STYLE_MISSING/);
  assert.throws(() => extractStyleAndPage('<style>body{}</style>', slide), /PRESENTATION_MAIN_MISSING/);
});

test('presentation rendering requires and emits the complete slide manifest', () => {
  const extracted = SLIDES.map(slide => ({
    ...slide,
    scopedCss: `#${slide.id} {}`,
    pageHtml: `<div class="page-shell">${slide.label}</div>`,
  }));
  const html = renderCombinedDeck(extracted);
  assert.equal((html.match(/class="slide-scope"/g) ?? []).length, 11);
  assert.match(html, /Generated by tools\/build-presentation-html\.mts/);
  assert.throws(() => renderCombinedDeck(extracted.slice(1)), /PRESENTATION_SLIDE_COUNT_INVALID/);
});
