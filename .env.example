# 각 패키지에서 루트 .env를 자동으로 읽습니다. 기존 환경 변수가 우선합니다.
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=.local/data/safehandoff.sqlite
CLIENT_HOST=127.0.0.1
CLIENT_PORT=5173
# 클라이언트 개발 서버가 서버 API로 프록시할 주소
SERVER_ORIGIN=http://127.0.0.1:8080
# 가짜 앱은 실제 앱의 포트·DB 환경 변수를 재사용하지 않습니다.
DEMO_HOST=127.0.0.1
DEMO_PORT=8081
DEMO_DATABASE_PATH=.local/data/demo.sqlite

# 실제 앱의 모델 연결. 빈 값이면 모델 준비 안 됨으로 표시합니다.
SAFEHANDOFF_LLM_BASE_URL=
SAFEHANDOFF_LLM_MODEL=
SAFEHANDOFF_LLM_API_KEY=
# 생략하면 config.json이 있을 때 사용하고, 없으면 config.example.json을 사용합니다.
# 상대 경로는 저장소 루트 기준입니다. HTTP 허용 여부·재시도는 이 설정에서 지정합니다.
# SAFEHANDOFF_CONFIG=config.example.json
# 설치 시 digest와 합성 입력을 등록한 파일. reproduction.enabled=true일 때만 사용합니다.
# just app은 재현이 켜져 있고 이 값이 없으면 이미지·등록을 준비해 앱 프로세스에 자동 전달합니다.
# SAFEHANDOFF_REPRO_REGISTRY=.local/repro-registration.json
# 로컬 transcript: 생략하면 기록하지 않습니다. 기본은 단계·결과 메타데이터만 기록합니다.
# SAFEHANDOFF_TRANSCRIPT_DIR=.local/transcripts
# 승인된 모델 입력·작성 초안도 기록하려면 1. 공개 전 수동 검토가 필요합니다.
# SAFEHANDOFF_TRANSCRIPT_CONTENT=1

# 단일 운영자 loopback task API. 켜면 시작 토큰을 터미널에만 표시합니다(5분·1회 사용).
# SAFEHANDOFF_WORKFLOW_ENABLED=1
# 선택: 운영자가 직접 준 32자 이상 시작 토큰. 같은 5분·1회 정책이며 응답/로그로 재노출하지 않습니다.
# SAFEHANDOFF_WORKFLOW_TOKEN=
# 운영자 프로젝트·수신자 카탈로그. 생략하면 두 목록은 비어 있습니다.
# 아래는 가상 예제이며 실제 운영 정보가 아닙니다.
# SAFEHANDOFF_WORKFLOW_CATALOG=fixtures/workflow/catalog.json
# 브라우저에서 실제 접속하는 origin과 API 서버 origin을 각각 정확하게 지정합니다.
# http loopback만 지원하며 LAN/다중 사용자 운영 인증은 이 구현 범위가 아닙니다.
# SAFEHANDOFF_WORKFLOW_BROWSER_ORIGIN=http://127.0.0.1:5173
# SAFEHANDOFF_WORKFLOW_SERVER_ORIGIN=http://127.0.0.1:8080
