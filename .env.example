# 앱과 live evaluator가 실행 디렉터리의 .env를 자동으로 읽습니다.
# 이미 export된 환경 변수가 우선합니다. source나 export는 필수가 아닙니다.
# API root에는 https:// 또는 http://와 /v1을 포함하고 /chat/completions는 붙이지 않습니다.
# HTTP를 사용하면 config.json의 provider.allow_plain_http=true가 필요합니다.
SAFEHANDOFF_LLM_BASE_URL=
SAFEHANDOFF_LLM_MODEL=
# 인증이 필요한 경우에만 설정
SAFEHANDOFF_LLM_API_KEY=
