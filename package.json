{
  "name": "safehandoff",
  "private": true,
  "scripts": {
    "lint": "qg check --full --rules-only",
    "test": "qg check --full",
    "test:go": "mise exec -- just test-go",
    "test:docs": "python3 tools/validate_docs.py",
    "test:qg": "node --test tools/qg.test.mjs",
    "test:server": "python3 -m unittest discover -s tools -p test_server.py"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@slop-lab/qg": "0.1.0"
  }
}
